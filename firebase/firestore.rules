rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /tourProgress/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.data.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /moments/{momentId} {
      allow read: if request.auth != null
                  && (resource.data.visibility == "public"
                      || resource.data.uid == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.visibility in ["private", "public"]
                    && request.resource.data.caption is string
                    && request.resource.data.caption.size() > 0
                    && request.resource.data.caption.size() <= 180;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.visibility in ["private", "public"]
                    && request.resource.data.caption is string
                    && request.resource.data.caption.size() > 0
                    && request.resource.data.caption.size() <= 180;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    match /momentReactions/{reactionId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && reactionId == request.resource.data.momentId + "_" + request.auth.uid
                            && request.resource.data.actorUid == request.auth.uid
                            && request.resource.data.ownerUid is string
                            && request.resource.data.momentId is string
                            && request.resource.data.reaction in ["👍", "💛", "🎉"]
                            && exists(/databases/$(database)/documents/moments/$(request.resource.data.momentId))
                            && request.resource.data.ownerUid == get(/databases/$(database)/documents/moments/$(request.resource.data.momentId)).data.uid
                            && (get(/databases/$(database)/documents/moments/$(request.resource.data.momentId)).data.visibility == "public"
                                || get(/databases/$(database)/documents/moments/$(request.resource.data.momentId)).data.uid == request.auth.uid);
      allow delete: if request.auth != null
                    && resource.data.actorUid == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow read: if request.auth != null
                  && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.actorUid == request.auth.uid
                    && request.resource.data.uid is string
                    && request.resource.data.type in ["moment_created", "moment_updated", "reaction_received"]
                    && request.resource.data.title is string
                    && request.resource.data.body is string;
      allow update, delete: if request.auth != null
                            && resource.data.uid == request.auth.uid;
    }

    match /achievements/{achievementId} {
      allow read: if request.auth != null
                  && resource.data.uid == request.auth.uid;
      allow create, update: if request.auth != null
                            && request.resource.data.uid == request.auth.uid
                            && request.resource.data.title is string
                            && request.resource.data.rarity in ["common", "rare", "epic", "legendary"];
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }
  }
}
