rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /tourProgress/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.data.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /moments/{momentId} {
      allow read: if request.auth != null
                  && (resource.data.visibility == "public"
                      || resource.data.uid == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.visibility in ["private", "public"]
                    && request.resource.data.caption is string
                    && request.resource.data.caption.size() > 0
                    && request.resource.data.caption.size() <= 180;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.visibility in ["private", "public"]
                    && request.resource.data.caption is string
                    && request.resource.data.caption.size() > 0
                    && request.resource.data.caption.size() <= 180;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }
  }
}
