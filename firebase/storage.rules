rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isValidImage() {
      return request.resource.size < 5 * 1024 * 1024
             && request.resource.contentType.matches('image/.*');
    }

    match /moment-images/{uid}/{momentId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isOwner(uid) && isValidImage();
      allow delete: if isOwner(uid);
    }

    match /profile-avatars/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isOwner(uid) && isValidImage();
      allow delete: if isOwner(uid);
    }

    match /campus-event-photos/{uid}/{photoId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isOwner(uid) && isValidImage();
      allow delete: if isOwner(uid);
    }

    match /forum-attachments/{uid}/{threadId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isOwner(uid) && isValidImage();
      allow delete: if isOwner(uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
